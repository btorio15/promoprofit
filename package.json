    "promos:check": "tsx --env-file=.env.local scripts/promos-check.ts",
    "promos:match-report": "tsx --env-file=.env.local scripts/promo-match-report.ts",
    "scrape:promos": "tsx scripts/scrape-promos.ts",
    "scrape:already-ran-today": "tsx scripts/already-ran-today.ts",
    "promos:reader-smoke": "tsx scripts/promo-reader-smoke.ts",
    "odds:smoke": "tsx --env-file=.env.local scripts/odds-smoke.ts",
    "odds:refresh": "tsx --env-file=.env.local scripts/refresh-odds.ts",
    "odds:morning-observe": "tsx scripts/morning-odds-observe.ts",
    "invite:create": "tsx --env-file=.env.local scripts/invite-create.ts",
    "password:reset": "tsx --env-file=.env.local scripts/password-reset.ts"
