# Neon Postgres connection string (server-only, never NEXT_PUBLIC_)
DATABASE_URL=

# The Odds API key (server-only, never NEXT_PUBLIC_ - see CLAUDE.md "What NOT to Use")
ODDS_API_KEY=

# Session cookie sealing secret (server-only, never NEXT_PUBLIC_). Must be
# >=32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# The deployed base URL (the https://...vercel.app address), used
# so `npm run invite:create` can print a full invite link.
APP_URL=

# Vercel Cron bearer secret (server-only, never NEXT_PUBLIC_). Generate with:
# openssl rand -hex 32. Set in the Vercel Production env.
CRON_SECRET=

# Fine-grained GitHub token, only the promoprofit repo, Actions read and write.
# Used by /api/cron/scrape to start the Scrape promos workflow. Server-only,
# never NEXT_PUBLIC_. Has an expiry date.
GH_DISPATCH_TOKEN=

# Optional owner/repo override for the dispatch (defaults to btorio15/promoprofit).
GH_REPO=
