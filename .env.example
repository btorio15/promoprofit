# Neon Postgres connection string (server-only, never NEXT_PUBLIC_)
DATABASE_URL=

# The Odds API key (server-only, never NEXT_PUBLIC_ - see CLAUDE.md "What NOT to Use")
ODDS_API_KEY=

# Session cookie sealing secret (server-only, never NEXT_PUBLIC_). Must be
# >=32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional: the deployed base URL (e.g. https://promoprofit.vercel.app), used
# only so `npm run invite:create` can print a full invite link.
APP_URL=
